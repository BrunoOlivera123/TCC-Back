# =====================================================================
# SOS Car BACKEND - modelo de configuracao (sem segredos)
#
# Copie para ".env" e preencha:
#     cp .env.example .env          (Linux/Mac)
#     copy .env.example .env        (Windows)
# O ".env" de verdade NUNCA deve ir para o GitHub nem para dentro de um .zip.
# Nenhuma variavel e obrigatoria: sem configurar nada o sistema roda em modo
# de demonstracao (dados so em memoria, admin padrao, codigo de recuperacao
# so no console se habilitado abaixo).
#
# Regras: uma variavel por linha, sem espacos ao redor do "=" e sem repetir
# a mesma variavel (o dotenv usa a PRIMEIRA). Valor com "#", espacos ou
# aspas vai entre aspas duplas.
# =====================================================================

# --- Servidor ---
#PORT=3000
#HOST=0.0.0.0
# HTTPS e o padrao (certificado de desenvolvimento gerado em .certs/).
# USAR_HTTPS=0 sobe em HTTP puro (ex.: atras de proxy/hospedagem que faz o HTTPS).
#USAR_HTTPS=0
#TLS_CERT_FILE=
#TLS_KEY_FILE=
# Atras de proxy reverso? Informe quantos proxies ha na frente (normalmente 1).
# NAO ative se nao ha proxy: o IP poderia ser forjado.
#TRUST_PROXY=1
#NODE_ENV=production

# --- CORS: enderecos do FRONTEND autorizados a chamar esta API ---
# Lista separada por virgulas, com esquema e porta, SEM barra no final.
# Nunca use "*". Sem esta variavel, em desenvolvimento ficam liberados
# http(s)://localhost:5173 e http(s)://127.0.0.1:5173; em producao, nenhum.
#CORS_ORIGINS=https://app.exemplo.com

# --- Banco de dados MySQL ---
# Se DB_HOST ficar em branco: tenta MySQL local (127.0.0.1) e, na falta dele,
# usa modo em memoria (dados se perdem ao reiniciar). As tabelas sao criadas
# automaticamente na primeira execucao.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Administrador ---
# Padrao (se omitido): admin@soscar.com / admin123. TROQUE antes de publicar.
# ADMIN_SENHA_HASH (hash bcrypt) e preferivel a ADMIN_SENHA em producao.
#ADMIN_EMAIL=
#ADMIN_SENHA=
#ADMIN_SENHA_HASH=

# --- E-mail (recuperacao de senha por codigo) ---
# Sem SMTP_USER/SMTP_PASS o codigo NAO e enviado.
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=

# --- Redefinicao de senha por codigo de 6 digitos ---
# Chave que protege os codigos no banco (HMAC). Use um texto longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela, o servidor usa uma chave temporaria (codigos pendentes caem ao reiniciar).
#CODIGO_REDEFINICAO_SEGREDO=
# SO para desenvolvimento: sem SMTP, imprime o CODIGO no terminal do servidor
# (ignorado com NODE_ENV=production).
#MOSTRAR_CODIGO_REDEFINICAO_NO_CONSOLE=1

# --- Login com Google (opcional) ---
# ID do cliente OAuth (tipo "Aplicativo da Web"). E um dado PUBLICO (o frontend o
# recebe de GET /api/auth/google/config); o servidor so valida o ID token,
# nao usa Client Secret. No console do Google, cadastre a URL do FRONTEND em
# "Origens JavaScript autorizadas" (ex.: http://localhost:5173).
#GOOGLE_CLIENT_ID=
# Opcional: aceita somente contas deste dominio Google Workspace.
#GOOGLE_DOMINIO_PERMITIDO=

# --- Integracoes externas (opcionais) ---
#OSM_USER_AGENT=SOS-Car-TCC/1.0 (contato: seu-email@exemplo.com)
#BUSCARCEP_CHAVE=
